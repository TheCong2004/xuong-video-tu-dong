{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "ArtCraft",
  "version": "0.36.0",
  "identifier": "ai.artcraft.app",
  "build": {
    "frontendDist": "../../../frontend/apps/artcraft/dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "pnpm --dir d:/capcutpolot/artcraft/frontend --filter artcraft dev",
    "beforeBuildCommand": "pnpm --dir d:/capcutpolot/artcraft/frontend --filter artcraft build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": {
        "default-src": [
          "'self'",
          "'unsafe-eval'",
          "'unsafe-inline'",
          "blob:",
          "data:",
          "https://*.fakeyou.com",
          "https://*.storyteller.ai",
          "https://www.google-analytics.com",
          "https://www.googletagmanager.com",
          "ipc://localhost",
          "tauri://localhost"
        ],
        "connect-src": [
          "'self'",
          "'unsafe-eval'",
          "'unsafe-inline'",
          "asset:",
          "blob:",
          "data:",
          "http://ipc.localhost",
          "http://127.0.0.1:30000",
          "http://127.0.0.1:30000/*",
          "http://127.0.0.1:8080",
          "http://127.0.0.1:8080/*",
          "http://127.0.0.1:4750",
          "http://127.0.0.1:4750/*",
          "http://127.0.0.1:20128",
          "http://127.0.0.1:20128/*",
          "http://127.0.0.1:10108",
          "http://127.0.0.1:10108/*",
          "http://localhost:10108",
          "http://localhost:10108/*",
          "http://localhost:30000",
          "http://localhost:30000/*",
          "http://localhost:8080",
          "http://localhost:8080/*",
          "http://localhost:4750",
          "http://localhost:4750/*",
          "https://*.clarity.ms",
          "https://*.fakeyou.com",
          "https://*.storyteller.ai",
          "https://asset.localhost",
          "https://unpkg.com/detect-gpu@5.0.70/",
          "https://api.frankfurter.dev",
          "https://www.google-analytics.com",
          "https://www.googletagmanager.com",
          "ipc://localhost",
          "ws://127.0.0.1:30000",
          "ws://127.0.0.1:10108",
          "ws://localhost:10108",
          "ws://127.0.0.1:30000/*",
          "ws://localhost:30000",
          "ws://localhost:30000/*",
          "ws://127.0.0.1:8080",
          "ws://127.0.0.1:8080/*",
          "ws://localhost:8080",
          "ws://localhost:8080/*",
          "tauri://localhost"
        ],
        "font-src": "*",
        "img-src": [
          "",
          "'self'",
          "'unsafe-inline'",
          "*",
          "blob:",
          "data:",
          "https://*.fakeyou.com",
          "https://*.storyteller.ai",
          "ipc://localhost",
          "tauri://localhost"
        ],
        "script-src": [
          "'self'",
          "'unsafe-eval'",
          "'unsafe-inline'",
          "'wasm-unsafe-eval'",
          "asset:",
          "blob:",
          "data:",
          "https://*.clarity.ms",
          "https://*.fakeyou.com",
          "https://*.storyteller.ai",
          "https://*.unpkg.com",
          "https://clarity.ms",
          "https://unpkg.com",
          "ipc://localhost",
          "tauri:",
          "tauri://localhost"
        ],
        "style-src": [
          "'self'",
          "'unsafe-eval'",
          "'unsafe-inline'",
          "blob:",
          "data:",
          "https://*.fakeyou.com",
          "https://*.storyteller.ai",
          "https://fonts.googleapis.com",
          "ipc://localhost",
          "tauri://localhost"
        ],
        "frame-src": [
          "'self'",
          "http://127.0.0.1:4567",
          "http://localhost:4567",
          "http://127.0.0.1:20128",
          "http://127.0.0.1:20128/*",
          "http://localhost:20128"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/vanloctech/youwee/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0MzYxNjBFRDQwMzlEM0MKUldROG5RUFVEaFkybE5laTlyUVJXczNRdmFQS1dtc3hpalA3NWw1R2VmUlBDRC9FZCtoR2dlVWcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/youwee-yt-dlp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/capcut-mate",
      "resources/capcut-mate-server.exe",
      "resources/media-crawler",
      "resources/openmontage",
      "resources/ffmpeg",
      "resources/OmniRoute",
      "resources/donut-runtime"
    ]
  }
}
