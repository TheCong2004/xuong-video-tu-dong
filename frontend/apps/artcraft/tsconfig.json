{
  "extends": "../../tsconfig.base.json",
  "include": [
    "env.d.ts",
    "app/**/*.js",
    "app/**/*.ts",
    "app/**/*.tsx",
    "netlify-edge-plugin.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "app/**/node_modules",
    "dist",
    "build"
  ],
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "ESNext",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/src/*", "./app/src/pages/PageYouwee/*"],
      "@mediacrawler/*": ["./app/src/pages/PageMediaCrawler/src/*"],
      "~/*": ["./app/src/*"],
      "libs/*": ["../../libs/*"],
      "@frontend/build-env": ["../../libs/build-env/src/index.ts"],
      "@frontend/login": ["../../libs/login/src/index.ts"],
      "@storyteller/api-enums": ["../../libs/api-enums/src/index.ts"],
